CREATE TABLE lesson_run_settlement (
    run_id TEXT PRIMARY KEY NOT NULL,
    lesson_id TEXT NOT NULL,
    completed_at_epoch_millis INTEGER NOT NULL
);

selectLessonRunSettlement:
SELECT run_id FROM lesson_run_settlement WHERE run_id = ?;

insertLessonRunSettlement:
INSERT INTO lesson_run_settlement (run_id, lesson_id, completed_at_epoch_millis)
VALUES (?, ?, ?);
