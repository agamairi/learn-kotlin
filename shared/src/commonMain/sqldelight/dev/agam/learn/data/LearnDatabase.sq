CREATE TABLE exercise_result (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    exercise_id TEXT NOT NULL,
    correct INTEGER NOT NULL,
    xp_awarded INTEGER NOT NULL,
    epoch_millis INTEGER NOT NULL
);

CREATE TABLE daily_activity (
    epoch_day INTEGER PRIMARY KEY NOT NULL,
    xp_earned INTEGER NOT NULL,
    exercises_completed INTEGER NOT NULL,
    goal_met INTEGER NOT NULL
);

CREATE TABLE review_card (
    item_id TEXT PRIMARY KEY NOT NULL,
    box INTEGER NOT NULL,
    due_epoch_day INTEGER NOT NULL
);

CREATE TABLE settings_kv (
    key TEXT PRIMARY KEY NOT NULL,
    value TEXT NOT NULL
);

insertExerciseResult:
INSERT INTO exercise_result (exercise_id, correct, xp_awarded, epoch_millis)
VALUES (?, ?, ?, ?);

selectAllExerciseResults:
SELECT * FROM exercise_result;

selectExerciseResultsForExercise:
SELECT * FROM exercise_result WHERE exercise_id = ?;

insertDailyActivity:
INSERT OR REPLACE INTO daily_activity (epoch_day, xp_earned, exercises_completed, goal_met)
VALUES (?, ?, ?, ?);

selectAllDailyActivities:
SELECT * FROM daily_activity ORDER BY epoch_day ASC;

selectDailyActivityByDay:
SELECT * FROM daily_activity WHERE epoch_day = ?;

insertReviewCard:
INSERT OR REPLACE INTO review_card (item_id, box, due_epoch_day)
VALUES (?, ?, ?);

selectAllReviewCards:
SELECT * FROM review_card;

selectDueReviewCards:
SELECT * FROM review_card WHERE due_epoch_day <= ?;

selectReviewCardById:
SELECT * FROM review_card WHERE item_id = ?;

insertSetting:
INSERT OR REPLACE INTO settings_kv (key, value)
VALUES (?, ?);

selectSettingByKey:
SELECT value FROM settings_kv WHERE key = ?;
